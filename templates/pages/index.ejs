<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>PRM</title>
        <link rel="stylesheet" href="./css/styles.css">
        <link rel="stylesheet" href="css/icons.css">
        <link rel="stylesheet" href="css/interaction-types.css">
        <link rel="stylesheet" href="css/focus.css">
        <link rel="stylesheet" href="./css/navbar.css">
        <link rel="stylesheet" href="./css/avatar.css">
        <link rel="stylesheet" href="./css/dashboard/dashboard.css">
        <link rel="stylesheet" href="css/layout.css">
        <link rel="stylesheet" href="css/buttons.css">
        <link rel="stylesheet" href="css/dashboard/empty-state.css">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap">
    <link rel="stylesheet" href="css/toast.css">
</head>

<body>
    <div class="main-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/sidebar', { activePage: 'index'})%>

        <%- include('../partials/topbar') %>

        <!-- Main Content Area -->
        <main class="dashboard">
            <!-- Main Heading of the page -->
            <header>
                <h1>Your Network</h1>
                <p>Track, remember, and nurture the people who matter.</p>
            </header>

            <section id="dashboard-empty-state" class="card dashboard-no-file" aria-labelledby="dashboard-empty-title" hidden>
                <h2 id="dashboard-empty-title">No file open</h2>
                <p>Your network is saved in a .json file on your computer. Open one you downloaded before, or start a new one.</p>
                <div class="dashboard-no-file-actions">
                    <button type="button" class="btn-primary" data-open-file>Open file</button>
                    <button type="button" class="dashboard-link" data-new-file>Create new file</button>
                </div>
                <input type="file" accept=".json,application/json" aria-label="Choose a PRM .json file" hidden>
            </section>
            <section class="dashboard-grid" hidden>
                <div class="card">
                    <p>PEOPLE</p>
                    <p class="main-stat" id="total-people">0</p>
                    <p>In your network</p>
                </div>
                <div class="card">
                    <p>RECENT</p>
                    <p class="main-stat" id="total-interactions-this-month">0</p>
                    <p>Interactions this month</p>
                </div>
                <div class="card">
                    <p>CATEGORIES</p>
                    <p class="main-stat" id="total-categories">0</p>
                    <p>Types of connection</p>
                </div>

                <!-- Inner Grid -->
                <div class="dashboard-inner-grid">
                    <div class="card network-by-category">
                        <p>NETWORK BY CATEGORY</p>
                        <div>

                        </div>
                    </div>
                    <div class="card recent-activity">
                        <p>RECENT ACTIVITY</p>
                        <div>

                        </div>
                    </div>

                    <div class="card reconnect-soon">
                        <p>RECONNECT SOON</p>
                        <div>

                        </div>
                    </div>

                    <div class="card upcoming-important-dates">
                        <p>REMINDERS &amp; IMPORTANT DATES</p>
                        <div>

                        </div>
                    </div>
                </div>


            </section>
        </main>
    </div>
    <script type="module" src="./js/dashboard/dashboard.js"></script>
    <script type="module" src="js/navbar.js"></script>
</body>

</html>
