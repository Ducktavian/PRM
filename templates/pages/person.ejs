<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>Person | RELM</title>

    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/icons.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/people/cards.css">
    <link rel="stylesheet" href="css/avatar.css">
    <link rel="stylesheet" href="css/interaction-types.css">
    <link rel="stylesheet" href="css/modal.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap">
    <link rel="stylesheet" href="css/buttons.css">
    <link rel="stylesheet" href="css/focus.css">
    <link rel="stylesheet" href="css/people/empty-state.css">
    <link rel="stylesheet" href="css/toast.css">
</head>

<body class="person-view-page">

    <%- include('../partials/sidebar', { activePage: 'people' })%>

    <%- include('../partials/topbar') %>

    <main class="main-content">
        <div class="top-nav-actions">
            <a href="people.html" class="back-link">
                <img src="assets/back-icon.svg" alt="" width="18" height="18">
                Back
            </a>

            <div class="header-action-buttons">
                <button type="button" class="btn-secondary" data-edit-person disabled>
                    <i class="fa-regular fa-pen-to-square"></i> Edit
                </button>

                <button type="button" class="btn-icon-danger" title="Delete" aria-label="Delete person" data-delete-person disabled>
                    <i class="fa-regular fa-trash-can"></i>
                </button>
            </div>
        </div>

        <p id="person-state" role="status"></p><p id="person-error" role="alert"></p><div id="person-content" hidden><section class="person-profile-header">
            <div class="avatar avatar-xl" data-person-avatar></div>

            <div class="profile-header-details">
                <h1 data-person-name>Person Name</h1>
                <span class="pronouns" data-person-pronouns>pronouns</span>
                <div data-person-category></div>
                <p class="role-company" data-person-role-company>Role - Company</p>
            </div>
        </section>

        <section class="person-details-grid">
            <div class="detail-group">
                <h3 class="group-title">CONTACT</h3>

                <div class="detail-item">
                    <label>EMAIL</label>
                    <a href="#" class="link-text" data-person-email>
                        <i class="fa-regular fa-envelope"></i> email@example.com
                    </a>
                </div>

                <div class="detail-item">
                    <label>PHONE</label>
                    <p data-person-phone><i class="fa-solid fa-phone"></i> Phone</p>
                </div>

                <div class="detail-item">
                    <label>LOCATION</label>
                    <p data-person-location><i class="fa-solid fa-location-dot"></i> Location</p>
                </div>

                <div class="detail-item">
                    <label>PREFERRED CONTACT</label>
                    <p data-person-preferred-contact>Preferred contact</p>
                </div>
            </div>

            <div class="detail-group">
                <h3 class="group-title">PERSONAL</h3>

                <div class="detail-item">
                    <label>BIRTHDAY</label>
                    <p data-person-birthday>Birthday</p>
                </div>

                <div class="detail-item">
                    <label>PRONOUNS</label>
                    <p data-person-pronouns-detail>Pronouns</p>
                </div>

                <div class="detail-item">
                    <label>OCCUPATION</label>
                    <p data-person-occupation>Occupation</p>
                </div>
            </div>

            <div class="detail-group">
                <h3 class="group-title">RELATIONSHIP</h3>

                <div class="detail-item">
                    <label>CATEGORY</label>
                    <div data-person-category-detail></div>
                </div>

                <div class="detail-item">
                    <label>WORKPLACE / SCHOOL</label>
                    <p data-person-workplace>Workplace</p>
                </div>

                <div class="detail-item">
                    <label>HOW YOU MET</label>
                    <p data-person-how-met>How you met</p>
                </div>

                <div class="detail-item">
                    <label>DATE YOU MET</label>
                    <p data-person-date-met>Date met</p>
                </div>
            </div>
        </section>

        <section class="person-tags-notes-section">
            <div class="tag-category">
                <label>INTERESTS</label>
                <div class="tags-list" data-person-interests></div>
            </div>

            <div class="tag-category">
                <label>SKILLS</label>
                <div class="tags-list" data-person-skills></div>
            </div>

            <div class="two-column-tags">
                <div class="tag-category">
                    <label>LIKES</label>
                    <div class="tags-list" data-person-likes></div>
                </div>

                <div class="tag-category">
                    <label>DISLIKES</label>
                    <div class="tags-list" data-person-dislikes></div>
                </div>
            </div>

            <div class="tag-category"><label>SHARED TOPICS</label><div class="tags-list" data-person-shared-topics></div></div><div class="notes-block">
                <label>NOTES</label>
                <p data-person-notes></p>
            </div>
        </section>

        <section class="bottom-sections-grid">
            <div class="card-box">
                <div class="card-box-header">
                    <h2>REMINDERS</h2>
                    <button type="button" class="reminder-add-btn" data-add-reminder>
                        <img src="assets/add-purple-icon.svg" alt="" width="14" height="14">
                        Add
                    </button>
                </div>

                <div class="reminders-list" data-person-reminders></div></div>

            <div class="card-box">
                <div class="card-box-header">
                    <h2>PREVIOUS INTERACTIONS</h2>
                </div>

                <div class="interactions-list" data-person-interactions></div>
            </div>
        </section>
        </div>
    </main>

    <%- include('../partials/person-modal') %>

    <div class="modal-overlay" id="add-reminder-modal">
        <div class="modal-content" style="max-width: 450px;" role="dialog" aria-modal="true" aria-label="add reminder">
            <div class="modal-header">
                <h2>Add Reminder</h2>
                <a href="#" class="close-btn" aria-label="Close">&times;</a>
            </div>

            <form>
                <div class="modal-body">
                    <div class="form-group full-width">
                        <label for="add-reminder-title">TITLE *</label>
                        <input type="text" name="title" id="add-reminder-title" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="add-reminder-date">DATE *</label>
                        <input type="date" name="date" id="add-reminder-date" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="add-reminder-details">DETAILS</label>
                        <textarea name="details" id="add-reminder-details" rows="3"></textarea>
                    </div>
                </div>

                <p role="alert"></p><div class="modal-actions">
                    <a href="#" class="btn-modal-cancel">Cancel</a>
                    <button type="submit" class="btn-primary">Add Reminder</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="edit-reminder-modal">
        <div class="modal-content" style="max-width: 450px;" role="dialog" aria-modal="true" aria-label="edit reminder">
            <div class="modal-header">
                <h2>Edit Reminder</h2>
                <a href="#" class="close-btn" aria-label="Close">&times;</a>
            </div>

            <form>
                <div class="modal-body">
                    <div class="form-group full-width">
                        <label for="edit-reminder-title">TITLE *</label>
                        <input type="text" name="title" id="edit-reminder-title" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="edit-reminder-date">DATE *</label>
                        <input type="date" name="date" id="edit-reminder-date" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="edit-reminder-details">DETAILS</label>
                        <textarea name="details" id="edit-reminder-details" rows="3"></textarea>
                    </div>
                </div>

                <p role="alert"></p><div class="modal-actions">
                    <a href="#" class="btn-modal-cancel">Cancel</a>
                    <button type="submit" class="btn-primary">Update Reminder</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="delete-reminder-modal">
        <div class="delete-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-reminder-title" aria-describedby="delete-reminder-description">
            <div class="delete-icon" aria-hidden="true"><span></span></div>
            <h2 id="delete-reminder-title">Delete reminder?</h2>
            <p id="delete-reminder-description">This will permanently remove this reminder. This cannot be undone.</p>
            <p id="delete-reminder-error" role="alert"></p><div class="modal-footer">
                <a href="#" class="modal-cancel">Cancel</a>
                <button type="button" class="delete-confirm">Delete</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="delete-person-modal">
        <div class="delete-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-person-title" aria-describedby="delete-person-description">
            <div class="delete-icon" aria-hidden="true"><span></span></div>
            <h2 id="delete-person-title" data-delete-person-title>Delete person?</h2>
            <p id="delete-person-description" data-delete-person-description>This will permanently remove this person and all their interactions and reminders.</p>
            <p id="delete-person-error" role="alert"></p><div class="modal-footer">
                <a href="#" class="modal-cancel">Cancel</a>
                <button type="button" class="delete-confirm">Delete</button>
            </div>
        </div>
    </div>

    <script type="module" src="js/people/person.js"></script>
    <script type="module" src="js/navbar.js"></script>
</body>

</html>
