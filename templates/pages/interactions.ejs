<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Interactions | PRM</title>

    <link rel="stylesheet" href="css/icons.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/filters.css">
    <link rel="stylesheet" href="css/pagination.css">
    <link rel="stylesheet" href="css/avatar.css">
    <link rel="stylesheet" href="css/interaction-types.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap">
    <link rel="stylesheet" href="css/modal.css">
    <link rel="stylesheet" href="css/buttons.css">
    <link rel="stylesheet" href="css/focus.css">
    <link rel="stylesheet" href="css/interaction-empty-state.css">
    <link rel="stylesheet" href="css/list-page.css">
    <link rel="stylesheet" href="css/toast.css">
</head>

<body class="interactions-page">

    <%- include('../partials/sidebar', { activePage: 'interactions' })%>

    <%- include('../partials/topbar') %>

    <main>        
        <!-- page title -->
        <section class="page-header">
            <div>
            <h1>Interactions</h1>
            <p>
                View and record conversations, meetings, calls, messages,
                and events.
            </p>
            </div>
            <!-- add interaction button -->
            <button type="button" class="add-interaction btn-primary" hidden>
                <img src="assets/plus-icon.svg" alt="" width="16" height="16">
                Add Interaction
            </button>
        </section>

        <!-- search bar and filters -->
        <section class="page-filters" aria-label="Interaction filters" hidden>

            <div class="search-field">
                <img class="search-icon" src="assets/search-icon.svg" alt="" width="16" height="16">
                <input type="search" aria-label="Search interactions" placeholder="Search by name, title, or notes...">
                <button class="search-clear" type="button" aria-label="Clear search" hidden>
                    <img src="assets/close-icon.svg" alt="" width="14" height="14">
                </button>
            </div>

            <div class="filter-select interaction-type-filter">
                <select aria-label="Filter by interaction type">
                    <option>All types</option>
                    <option>Conversation</option>
                    <option>Meeting</option>
                    <option>Call</option>
                    <option>Message</option>
                    <option>Event</option>
                </select>
                <img src="assets/dropdown-icon.svg" alt="" width="12" height="12">
                <button class="mobile-filter-toggle" type="button" aria-label="Filter by interaction type" aria-controls="mobile-type-options" aria-expanded="false">
                    <img src="assets/filter-icon.svg" alt="" width="20" height="20">
                </button>
                <div class="mobile-filter-options" id="mobile-type-options" aria-label="Interaction types" hidden></div>
            </div>
            <div class="filter-select interaction-date-filter">
                <select aria-label="Filter by date">
                    <option>All dates</option>
                    <option>Last 7 days</option>
                    <option>Last 30 days</option>
                    <option>Last 90 days</option>
                    <option>This year</option>
                </select>
                <img src="assets/dropdown-icon.svg" alt="" width="12" height="12">
                <button class="mobile-filter-toggle" type="button" aria-label="Filter by date" aria-controls="mobile-date-options" aria-expanded="false">
                    <img src="assets/date-filter-icon.svg" alt="" width="20" height="20">
                </button>
                <div class="mobile-filter-options" id="mobile-date-options" aria-label="Date ranges" hidden></div>
            </div>
        </section>

        <section id="interaction-empty-state" class="interaction-empty-state" aria-labelledby="empty-state-title" hidden>
            <span class="empty-state-icon" aria-hidden="true">
                <img src="assets/interactions-selected-icon.svg" alt="" width="28" height="28">
            </span>
            <h2 id="empty-state-title"></h2>
            <p></p>
            <a class="btn-primary" href="files.html" hidden>Go to Files</a>
            <button type="button" class="btn-primary" hidden>Add Interaction</button>
        </section>

        <!-- interaction table -->
        <section class="interaction-history" aria-labelledby="interaction-heading">
            <h2 id="interaction-heading" class="visually-hidden">
                Interaction History
            </h2>

            <ul class="interaction-list"></ul>
        </section>
        <!-- pagination -->
        <nav class="pagination" aria-label="Interaction pages" hidden>
            <output id="interaction-status" class="interaction-status pagination-status"></output>
            <button type="button" class="pagination-direction" disabled>
                <img src="assets/chevron-left-icon.svg" alt="" width="16" height="16"> Previous
            </button>
            <button type="button" aria-label="Page 1" aria-current="page">1</button>
            <button type="button" class="pagination-direction">
                Next <img src="assets/chevron-right-icon.svg" alt="" width="16" height="16">
            </button>
        </nav>
    </main>

    <div id="interaction-actions" class="action-menu" hidden>
        <button type="button" class="action-edit">Edit</button>
        <button type="button" class="action-delete">Delete</button>
    </div>

    <!-- add interaction modal -->
    <dialog id="add-interaction-dialog" class="interaction-modal" aria-labelledby="add-interaction-title">
        <form id="add-interaction-form" method="dialog">
            <div class="modal-header">
                <h2 id="add-interaction-title">Add Interaction</h2>
                <button type="button" class="modal-close" aria-label="Close interaction dialog">
                    <img src="assets/close-icon.svg" alt="" width="16" height="16">
                </button>
            </div>

            <div class="modal-body">
                <p id="interaction-error" role="alert"></p>
                <div class="modal-field">
                    <label for="interaction-person">Person <span aria-hidden="true">*</span></label>
                    <select id="interaction-person" name="personId" required>
                        <option value="" disabled selected>Select a person</option>
                    </select>
                </div>

                <div class="modal-row">
                    <div class="modal-field">
                        <label for="interaction-date">Date <span aria-hidden="true">*</span></label>

                        <input type="date" id="interaction-date" name="date" required>
                    </div>

                    <div class="modal-field">
                        <label for="interaction-type">Type <span aria-hidden="true">*</span></label>
                        <select id="interaction-type" name="type" required>
                            <option value="" disabled selected>Choose a type</option>
                            <option value="Conversation">Conversation</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Call">Call</option>
                            <option value="Message">Message</option>
                            <option value="Event">Event</option>
                        </select>
                    </div>
                </div>

                <div class="modal-field">
                    <label for="interaction-time">Time (optional)</label>
                    <input type="time" id="interaction-time" name="time">
                </div>
                <div class="modal-field">
                    <label for="interaction-title">Title or Subject <span aria-hidden="true">*</span></label>
                    <input type="text" id="interaction-title" name="title" placeholder="Brief summary" required>
                </div>

                <div class="modal-field">
                    <label for="interaction-notes">Notes</label>
                    <textarea id="interaction-notes" name="notes" rows="4" placeholder="What happened? What was discussed?"></textarea>
                </div>

                <div class="modal-field">
                    <label for="interaction-follow-up">Follow-up Note (optional)</label>
                    <input type="text" id="interaction-follow-up" name="followUp" placeholder="e.g. Send the article by next week">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="modal-cancel">Cancel</button>
                <button type="submit" class="modal-submit">Add Interaction</button>
            </div>
        </form>
    </dialog>

    <!-- Delete interaction confirmation -->
    <dialog id="delete-interaction-dialog" class="delete-modal" aria-labelledby="delete-interaction-title" aria-describedby="delete-interaction-description">
        <form method="dialog">
            <div class="delete-icon" aria-hidden="true"><span></span></div>
            <p id="delete-error" role="alert"></p>
            <h2 id="delete-interaction-title">Delete interaction?</h2>
            <p id="delete-interaction-description">This will permanently remove this interaction record. This cannot be undone.</p>
            <div class="modal-footer">
                <button type="submit" class="modal-cancel" autofocus>Cancel</button>
                <button type="button" class="delete-confirm">Delete</button>
            </div>
        </form>
    </dialog>

    <template id="interaction-card-template">
        <li class="interaction-card">
            <div class="interaction-summary">
                <span class="person-avatar" aria-hidden="true"></span>

                <div class="interaction-main">
                    <div class="interaction-meta">
                        <span class="person-name"></span>
                        <span class="type-badge"></span>
                        <time></time>
                    </div>
                    <p class="interaction-title"></p>
                </div>

                <button type="button" class="interaction-toggle" aria-expanded="false">View</button>

                <button type="button" class="action-button" aria-label="Actions for this interaction">
                    <img src="assets/more-options-icon.svg" alt="" width="26" height="28">
                </button>
            </div>

            <div class="interaction-notes" hidden>
                <p></p>
            </div>
        </li>
    </template>

    <script type="module" src="js/interactions/main.js"></script>
    <script type="module" src="js/navbar.js"></script>
</body>
</html>
