<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>People | RELM</title>

    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/icons.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/pagination.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/people/cards.css">
    <link rel="stylesheet" href="css/avatar.css">
    <link rel="stylesheet" href="css/filters.css">
    <link rel="stylesheet" href="css/modal.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap">
    <link rel="stylesheet" href="css/buttons.css">
    <link rel="stylesheet" href="css/focus.css">
    <link rel="stylesheet" href="css/people/empty-state.css">
    <link rel="stylesheet" href="css/list-page.css">
    <link rel="stylesheet" href="css/toast.css">
</head>

<body class="people-page">
    
    <%- include('../partials/sidebar', { activePage: 'people' })%>

    <%- include('../partials/topbar') %>

    <main class="main-content">
        <header class="page-header">
            <div class="header-text">
                <h1>People</h1>
                <p>Your personal and professional network.</p>
            </div>

            <button type="button" class="btn btn-primary" id="open-add-person-btn" disabled>
                <img src="assets/add-icon.svg" alt="" width="16" height="16">
                Add Person
            </button>
        </header>

        <section class="page-filters" aria-label="People filters">
            <div class="search-field">
                <img class="search-icon" src="assets/search-icon.svg" alt="" width="16" height="16">
                <input type="search" placeholder="Search by name, skill, interest, or location..." aria-label="Search people">
                <button class="search-clear" type="button" aria-label="Clear search" hidden>
                    <img src="assets/close-icon.svg" alt="" width="14" height="14">
                </button>
            </div>

            <div class="filter-select">
                <select aria-label="Filter by category">
                    <option value="all">All categories</option>
                    <option value="mentor">Mentor</option>
                    <option value="coworker">Coworker</option>
                    <option value="friend">Friend</option>
                    <option value="family">Family</option>
                    <option value="classmate">Classmate</option>
                    <option value="other">Other</option>
                </select>
                <img src="assets/dropdown-icon.svg" alt="" width="12" height="12">
                <button class="mobile-filter-toggle" type="button" aria-label="Filter by category" aria-controls="mobile-category-options" aria-expanded="false">
                    <img src="assets/filter-icon.svg" alt="" width="24" height="24">
                </button>
                <div class="mobile-filter-options" id="mobile-category-options" aria-label="Categories" hidden></div>
            </div>
        </section>

        <section id="people-state" class="people-empty-state" aria-labelledby="people-empty-title" hidden>
            <span class="people-empty-icon" aria-hidden="true"><img src="assets/people-selected-icon.svg" alt="" width="28" height="28"></span>
            <h2 id="people-empty-title"></h2>
            <p></p>
            <a class="btn-primary" href="files.html" hidden>Go to Files</a>
            <button type="button" class="btn-primary" hidden>Add Person</button>
        </section>
        <section class="people-grid" id="people-grid" aria-label="People"></section>

        <nav class="pagination" aria-label="People pages">
            <output class="results-count pagination-status">Showing 0-0 of 0 people</output>
            <div class="pagination-controls">
                <button type="button" class="pagination-direction" data-pagination="prev" aria-label="Previous page">
                    <img src="assets/chevron-left-icon.svg" alt="" width="16" height="16">
                    <span class="pagination-direction-label">Previous</span>
                </button>

                <div class="pagination-pages">
                    <button type="button" class="pagination-page" data-page="1" aria-current="page">1</button>
                    <button type="button" class="pagination-page" data-page="2">2</button>
                    <button type="button" class="pagination-page" data-page="3">3</button>
                </div>

                <button type="button" class="pagination-direction" data-pagination="next" aria-label="Next page">
                    <span class="pagination-direction-label">Next</span>
                    <img src="assets/chevron-right-icon.svg" alt="" width="16" height="16">
                </button>
            </div>
        </nav>
    </main>

    <%- include('../partials/person-modal') %>

    <script type="module" src="js/people/main.js"></script>
    <script type="module" src="js/navbar.js"></script>
</body>

</html>
