    <!-- add / edit person modal, controlled by js/people/person-modal.js -->
    <div class="modal-overlay" id="person-modal">
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="person-modal-title">
            <div class="modal-header">
                <h2 id="person-modal-title">Add Person</h2>
                <a href="#" class="close-btn" aria-label="Close">&times;</a>
            </div>

            <form>
                <div class="modal-body">
                    <fieldset class="form-section">
                        <legend class="section-title">BASIC INFORMATION</legend>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-first-name">FIRST NAME *</label>
                                <input type="text" id="person-first-name" name="firstName" placeholder="e.g. Jordan" autocomplete="off" required>
                            </div>

                            <div class="form-group">
                                <label for="person-middle-name">MIDDLE NAME (OPTIONAL)</label>
                                <input type="text" id="person-middle-name" name="middleName" autocomplete="off">
                            </div>

                            <div class="form-group">
                                <label for="person-last-name">LAST NAME (OPTIONAL)</label>
                                <input type="text" id="person-last-name" name="lastName" placeholder="e.g. Rivera" autocomplete="off">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-category">RELATIONSHIP CATEGORY *</label>
                                <select id="person-category" name="category" required>
                                    <option value="" disabled selected>Select category</option>
                                    <option value="Friend">Friend</option>
                                    <option value="Mentor">Mentor</option>
                                    <option value="Coworker">Coworker</option>
                                    <option value="Professional">Professional</option>
                                    <option value="Family">Family</option>
                                    <option value="Classmate">Classmate</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="person-pronouns">PRONOUNS (OPTIONAL)</label>
                                <input type="text" id="person-pronouns" name="pronouns" placeholder="e.g. she/her, he/him, they/them">
                            </div>
                        </div>

                        <div class="form-group full-width" data-custom-category hidden>
                            <label for="person-custom-category">CUSTOM RELATIONSHIP</label>
                            <input type="text" id="person-custom-category" name="customCategory" placeholder="e.g. Neighbor, Teammate, Client" disabled>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-birthday">BIRTHDAY</label>
                                <input type="date" id="person-birthday" name="birthday">
                                <small class="sub-label">Age will be calculated automatically.</small>
                            </div>

                            <div class="form-group">
                                <label for="person-occupation">OCCUPATION OR ROLE</label>
                                <input type="text" id="person-occupation" name="occupation" placeholder="e.g. Designer, Engineer, Student">
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="section-title">CONTACT</legend>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-email-0">EMAIL</label>
                                <div class="multi-input-list" data-multi="email" data-type="email" data-label="email" data-placeholder="email@example.com"></div>
                                <button type="button" class="btn-add-entry" data-add-entry="email">+ Add email</button>
                            </div>

                            <div class="form-group">
                                <label for="person-phone-0">PHONE NUMBER</label>
                                <div class="multi-input-list" data-multi="phone" data-type="tel" data-label="phone number" data-placeholder="+1 (000) 000-0000"></div>
                                <button type="button" class="btn-add-entry" data-add-entry="phone">+ Add phone</button>
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label for="person-preferred-contact">PREFERRED CONTACT METHOD</label>
                            <select id="person-preferred-contact" name="preferredContact"><option value="">Not specified</option>
                                <option value="Email">Email</option>
                                <option value="Phone">Phone</option>
                                <option value="Message">Message</option>
                            </select>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="section-title">LOCATION</legend>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-country">COUNTRY</label>
                                <input type="text" id="person-country" name="locationCountry" placeholder="e.g. Philippines" autocomplete="off">
                            </div>

                            <div class="form-group">
                                <label for="person-province">PROVINCE / STATE</label>
                                <input type="text" id="person-province" name="locationProvinceOrState" placeholder="e.g. Metro Manila" autocomplete="off">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-city">CITY / MUNICIPALITY</label>
                                <input type="text" id="person-city" name="locationCity" placeholder="e.g. Makati" autocomplete="off">
                            </div>

                            <div class="form-group">
                                <label for="person-street">STREET ADDRESS</label>
                                <input type="text" id="person-street" name="locationStreet" placeholder="House/unit no., street, barangay" autocomplete="off">
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label for="person-location-notes">LOCATION NOTES</label>
                            <textarea id="person-location-notes" name="locationNotes" placeholder="Describe the place: landmarks, building color, directions, gate code..." rows="3"></textarea>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="section-title">RELATIONSHIP</legend>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-workplace">WORKPLACE OR SCHOOL</label>
                                <input type="text" id="person-workplace" name="workplace" placeholder="e.g. Google, MIT">
                            </div>

                            <div class="form-group">
                                <label for="person-date-met">DATE YOU MET</label>
                                <input type="date" id="person-date-met" name="dateMet">
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label for="person-how-met">HOW YOU MET</label>
                            <textarea id="person-how-met" name="howMet" placeholder="Where did you meet? What's the context?" rows="3"></textarea>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="section-title">THINGS TO REMEMBER</legend>

                        <div class="form-group full-width">
                            <label for="person-interests">INTERESTS</label>
                            <input type="text" id="person-interests" name="interests" placeholder="Ceramics, Hiking, Jazz...">
                        </div>

                        <div class="form-group full-width">
                            <label for="person-skills">SKILLS</label>
                            <input type="text" id="person-skills" name="skills" placeholder="Python, Design Systems, Teaching...">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="person-likes">LIKES</label>
                                <input type="text" id="person-likes" name="likes" placeholder="What they appreciate...">
                            </div>

                            <div class="form-group">
                                <label for="person-dislikes">DISLIKES</label>
                                <input type="text" id="person-dislikes" name="dislikes" placeholder="What they avoid...">
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label for="person-shared-topics">SHARED TOPICS</label>
                            <input type="text" id="person-shared-topics" name="sharedTopics" placeholder="Topics you discuss together...">
                        </div>

                        <div class="form-group full-width">
                            <label for="person-notes">NOTES</label>
                            <textarea id="person-notes" name="notes" placeholder="Conversation starters, personality notes, important context..." rows="4"></textarea>
                        </div>
                    </fieldset>
                </div>

                <p role="alert"></p><div class="modal-actions">
                    <a href="#" class="btn-modal-cancel">Cancel</a>
                    <button type="submit" class="btn-primary">Save Person</button>
                </div>
            </form>
        </div>
    </div>
